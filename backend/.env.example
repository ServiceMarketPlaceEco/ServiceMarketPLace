# Application
NODE_ENV=development
API_PORT=3001
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_password
DB_DATABASE=servicehub

# JWT Authentication
JWT_ACCESS_SECRET=your_super_secret_access_key_change_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Mail Configuration (Use Mailtrap for development, SendGrid/SES for production)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USER=your_mailtrap_user
MAIL_PASS=your_mailtrap_pass
MAIL_FROM=noreply@servicehub.com
MAIL_FROM_NAME=ServiceHub

# SMS for the customer signup code (Twilio). Leave blank on your laptop and the
# code is printed in the backend terminal instead. In production signup needs
# these, otherwise customers get "Phone verification is not available".
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# a Twilio phone number (+1...) or an approved sender name
TWILIO_FROM=
# added in front of local numbers like 01712345678 (use +61 to test in Australia)
SMS_DEFAULT_COUNTRY_CODE=+880

# Google Sign-In - OAuth 2.0 Web client ID from Google Cloud Console.
# Must match VITE_GOOGLE_CLIENT_ID in the frontend .env
GOOGLE_CLIENT_ID=

# CORS
CORS_ORIGIN=http://localhost:5173

# AI features (OpenAI) - optional, voice search falls back to rule-based matching
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# "Screen with AI" on the admin moderation page (Claude) - optional.
# without the key the button says "AI screening is not configured yet."
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Rate limits (per client IP). Every route has the default limit:
# at most RATE_LIMIT requests every RATE_LIMIT_WINDOW_MS
RATE_LIMIT=120
RATE_LIMIT_WINDOW_MS=60000
# Endpoints that call OpenAI or Claude (chatbot, voice-search matching,
# Screen with AI):
AI_RATE_LIMIT=20
AI_RATE_LIMIT_WINDOW_MS=60000
# Login, Google sign-in, password reset and the phone code routes, so
# passwords and codes can't be guessed over and over:
AUTH_RATE_LIMIT=5
AUTH_RATE_LIMIT_WINDOW_MS=60000

# Production only
# Behind a proxy or load balancer, set TRUST_PROXY=1 so the rate limits see
# each visitor's real IP instead of the proxy's.
TRUST_PROXY=
# Swagger (/api/docs) is off when NODE_ENV=production. Set to true to keep it on.
ENABLE_SWAGGER=
# In production the app will not start if JWT_ACCESS_SECRET is missing,
# shorter than 32 characters, or still starts with "your_" (the example value).
