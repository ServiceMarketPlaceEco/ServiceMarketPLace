# Compose settings for the VPS deployment (copy to .env next to
# docker-compose.yml). Backend settings go in backend/.env instead.

# Port on 127.0.0.1 the web container listens on; the server's nginx
# forwards the public domain here. Ask the server admin for a free one.
APP_PORT=8080

# Name of the Docker network the global-db MySQL container is on (ask the
# server admin)
DB_NETWORK=

# Google Sign-In client ID, baked into the frontend build (same value as
# GOOGLE_CLIENT_ID in backend/.env). Leave empty to hide Google sign-in.
VITE_GOOGLE_CLIENT_ID=

# Uncomment for ONE `project-ctl up` to create the tables and load seed
# data, then comment it out again
# COMPOSE_PROFILES=dbsetup
