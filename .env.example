# Compose settings for the VPS deployment (copy to .env next to
# docker-compose.yml, then chmod 600 .env). Backend settings go in
# backend/.env instead.

# Public domain Traefik routes to the web container (it also gets the
# Let's Encrypt certificate for it). Its DNS A record must point at the VPS.
APP_DOMAIN=

# Google Sign-In client ID, baked into the frontend build (same value as
# GOOGLE_CLIENT_ID in backend/.env). Leave empty to hide Google sign-in.
VITE_GOOGLE_CLIENT_ID=

# Uncomment for ONE `project-ctl up` to create the tables and load seed
# data, then comment it out again
# COMPOSE_PROFILES=dbsetup
