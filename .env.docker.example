# Settings for running ServiceHub with Docker (docker-compose.yml).
# Copy this file to .env in the same folder and fill it in. Never commit .env.
#
# Make long random values with:  openssl rand -hex 32

# ---------- address ----------
# the address people type to open the site
APP_URL=https://servicehub.example.com
CORS_ORIGIN=https://servicehub.example.com
# only for HTTPS with Caddy (docker compose --profile https up -d):
DOMAIN=servicehub.example.com
# port the website listens on. 80 without Caddy, 8080 with Caddy
WEB_PORT=80
# how many proxies sit in front of the API: 1 = nginx only, 2 = Caddy + nginx
TRUST_PROXY=1

# ---------- database ----------
DB_DATABASE=servicehub
DB_USERNAME=servicehub
DB_PASSWORD=change-me-long-random
DB_ROOT_PASSWORD=change-me-another-long-random

# ---------- logins ----------
# required: the API refuses to start in production without real values
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ---------- email (welcome, password reset, booking updates) ----------
# any SMTP provider, for example Brevo: smtp-relay.brevo.com, port 587
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@servicehub.example.com
MAIL_FROM_NAME=ServiceHub

# ---------- SMS for the signup code (Twilio) ----------
# without these, customers can't finish signing up on the live site
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_DEFAULT_COUNTRY_CODE=+880

# ---------- optional ----------
# Google sign-in (the same client id is built into the website)
GOOGLE_CLIENT_ID=
# AI chatbot and voice-search matching
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# "Screen with AI" on the moderation page
ANTHROPIC_API_KEY=
AI_RATE_LIMIT=20
AI_RATE_LIMIT_WINDOW_MS=60000
